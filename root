:root {
  --forest: #14241c;
  --cream: #f3eee6;
  --cream-2: #e7dfd2;
  --paper: #fffdf8;
  --ink: #1c1612;
  --muted: #6f675f;
  --line: rgba(28, 22, 18, 0.12);
  --paprika: #c24d24;
  --paprika-2: #9d3916;
  --gold: #e4c39a;
  --good: #1f7a4d;
  --danger: #9d3434;
  --shadow: 0 24px 50px rgba(20, 36, 28, 0.14);
  --radius: 28px;
  --sans: Manrope, "Segoe UI", sans-serif;
  --serif: Fraunces, Georgia, serif;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.5;
}
button, input, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
img { max-width: 100%; display: block; }
a { color: inherit; }
h1, h2, h3, p { margin: 0; }
.wrap { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
.kicker {
  margin: 0 0 10px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--paprika);
}
.hidden { display: none !important; }

.nav {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 16px 22px;
  color: #f6f1e8;
}
.nav.is-solid {
  background: rgba(243, 238, 230, 0.94);
  color: var(--ink);
  box-shadow: 0 1px 0 var(--line);
  backdrop-filter: blur(14px);
}
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  font-family: var(--serif);
  font-size: 26px;
  letter-spacing: -0.03em;
}
.logo i {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: var(--paprika);
  color: white;
  font-style: normal;
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 800;
}
.nav-links { display: flex; gap: 16px; margin-right: auto; }
.nav-links a { text-decoration: none; font-weight: 650; font-size: 14px; }
.langs { display: flex; padding: 3px; border: 1px solid currentColor; border-radius: 999px; }
.langs button {
  border: 0;
  background: transparent;
  border-radius: 999px;
  padding: 6px 9px;
  font-size: 12px;
  font-weight: 800;
  color: inherit;
}
.langs button.is-active { background: var(--paprika); color: white; }
.cart-btn, .btn {
  border: 0;
  border-radius: 999px;
  padding: 12px 16px;
  background: var(--paprika);
  color: white;
  font-weight: 750;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.btn-ghost { background: transparent; color: inherit; border: 1px solid currentColor; }
.btn-danger { background: var(--danger); color: white; margin-top: 16px; }
.btn-small { padding: 8px 12px; font-size: 13px; }
.cart-btn b {
  min-width: 22px;
  height: 22px;
  border-radius: 99px;
  display: grid;
  place-items: center;
  background: white;
  color: var(--paprika);
  font-size: 12px;
}
.nav.is-solid .cart-btn b { background: var(--forest); color: white; }

.hero {
  position: relative;
  min-height: 100vh;
  background:
    radial-gradient(900px 420px at 15% 10%, rgba(226, 179, 122, 0.16), transparent 60%),
    var(--forest);
  color: #f6f1e8;
  padding: 80px 0 92px;
}
.hero .kicker { color: var(--gold); }
.welcome {
  height: 28px;
  margin: 6px 0 4px;
  overflow: hidden;
  display: flex;
  align-items: center;
  mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent);
}
.welcome-track {
  display: flex;
  width: max-content;
  animation: welcome-marquee 36s linear infinite;
}
.welcome:hover .welcome-track { animation-play-state: paused; }
.welcome-track p {
  margin: 0;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
  line-height: 28px;
  color: var(--gold);
}
.welcome-track p::after {
  content: "·";
  margin: 0 32px;
  color: rgba(228, 195, 154, 0.55);
}
@keyframes welcome-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
.hero-grid {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 42px;
  align-items: center;
}
.hero h1 {
  font-family: var(--serif);
  font-weight: 560;
  font-size: clamp(48px, 6vw, 84px);
  line-height: 0.94;
  letter-spacing: -0.04em;
}
.hero h1 span { display: block; }
.hero h1 span:last-child { color: var(--gold); }
.hero-text { margin-top: 22px; max-width: 520px; font-size: 18px; color: rgba(246, 241, 232, 0.82); }
.hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
.hero-photo { position: relative; }
.hero-photo img {
  width: 100%;
  height: min(68vh, 620px);
  object-fit: cover;
  border-radius: 32px 32px 80px 32px;
  box-shadow: var(--shadow);
}
.ticket {
  position: absolute;
  left: -28px;
  bottom: 24px;
  width: min(280px, 80%);
  padding: 16px 16px 14px;
  border-radius: 20px;
  background: var(--paper);
  color: var(--ink);
  box-shadow: var(--shadow);
}
.ticket > span { color: var(--paprika); font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
.ticket strong { display: block; margin: 4px 0 8px; font-family: var(--serif); font-size: 32px; font-weight: 560; }
.ticket ul { list-style: none; margin: 0; padding: 0; }
.ticket li { display: flex; justify-content: space-between; padding: 6px 0; border-top: 1px dashed var(--line); font-weight: 700; }
.ticket em { display: block; margin-top: 8px; color: var(--muted); font-style: normal; font-size: 13px; }

.statbar {
  width: min(1120px, calc(100% - 40px));
  margin: -48px auto 0;
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
.stat {
  background: var(--paper);
  border-radius: 22px;
  padding: 18px 18px 16px;
  box-shadow: var(--shadow);
}
.stat b {
  display: block;
  font-family: var(--serif);
  font-size: 34px;
  font-weight: 560;
  letter-spacing: -0.04em;
  line-height: 1.05;
  overflow-wrap: anywhere;
}
.stat span { color: var(--muted); font-size: 14px; }
.band { padding: 72px 0; }
.band h2 {
  font-family: var(--serif);
  font-weight: 560;
  font-size: clamp(32px, 4vw, 52px);
  letter-spacing: -0.03em;
  line-height: 1.05;
}
.lead { color: var(--muted); margin-top: 10px; max-width: 640px; }

.table-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
.table-btn {
  width: 92px;
  height: 92px;
  border-radius: 22px;
  border: 1px solid var(--line);
  background: var(--paper);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
}
.table-btn b { font-family: var(--serif); font-size: 30px; font-weight: 560; line-height: 1; }
.table-btn small { color: var(--muted); font-size: 11px; }
.table-btn.is-on { background: var(--forest); color: #f6f1e8; border-color: var(--forest); }
.table-btn.is-on small { color: var(--gold); }
.table-now { margin-top: 16px; font-weight: 750; }

.cats { display: flex; gap: 8px; flex-wrap: wrap; margin: 22px 0; }
.chip {
  border: 1px solid var(--line);
  background: transparent;
  border-radius: 999px;
  padding: 8px 12px;
  font-weight: 750;
}
.chip.is-on { background: var(--ink); color: var(--cream); border-color: var(--ink); }
.dish-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  padding: 10px 0 16px;
}
.dish {
  background: var(--paper);
  border-radius: 26px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: dish-bob 3.4s ease-in-out infinite;
}
.dish:nth-child(2n) { animation-duration: 3.9s; animation-delay: -1.2s; }
.dish:nth-child(3n) { animation-duration: 3.1s; animation-delay: -2s; }
.dish:hover { animation-play-state: paused; }
.dish-photo { aspect-ratio: 4 / 3; background: #d9cfc2; }
.dish-photo img { width: 100%; height: 100%; object-fit: cover; }
.dish-body { padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
.dish h3 { font-size: 20px; letter-spacing: -0.02em; }
.dish p { color: var(--muted); font-size: 14px; flex: 1; }
.dish-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.price { font-weight: 800; }
.stepper { display: flex; align-items: center; gap: 8px; background: var(--cream); border-radius: 999px; padding: 4px; }
.stepper button {
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 50%;
  background: var(--forest);
  color: white;
  font-size: 18px;
}
@keyframes dish-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.record-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 22px 0; }
.record-list { display: flex; flex-direction: column; gap: 10px; }
.record {
  background: var(--paper);
  border-radius: 22px;
  padding: 14px 16px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px 16px;
  box-shadow: var(--shadow);
}
.record.is-best { box-shadow: inset 0 0 0 2px var(--paprika), var(--shadow); }
.record b { font-family: var(--serif); font-size: 28px; font-weight: 560; }
.record p { color: var(--muted); font-size: 14px; }
.record time { color: var(--muted); font-size: 13px; }
.record .tag {
  justify-self: end;
  align-self: start;
  background: #f3e2c2;
  color: #a56b12;
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 12px;
  font-weight: 800;
}
.empty {
  padding: 28px;
  border-radius: 24px;
  background: rgba(255, 253, 248, 0.7);
  color: var(--muted);
}

.qr-band { background: var(--forest); color: #f6f1e8; padding-bottom: 92px; }
.qr-grid { display: grid; grid-template-columns: 304px 1fr; gap: 28px; align-items: center; padding-top: 72px; }
.qr-frame { background: white; border-radius: 28px; padding: 12px; }
.qr-frame img { width: 280px; height: 280px; }
.qr-band .kicker { color: var(--gold); }
.qr-band h2 { font-family: var(--serif); font-weight: 560; font-size: clamp(32px, 4vw, 52px); letter-spacing: -0.03em; }
.qr-band p { color: rgba(246, 241, 232, 0.8); margin-top: 10px; }
.qr-url { margin-top: 14px; font-weight: 800; word-break: break-all; }
.footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 0 28px;
  color: rgba(246, 241, 232, 0.7);
  font-size: 14px;
}
.footer a { color: white; }

.one-dock {
  position: fixed;
  z-index: 45;
  left: 50%;
  bottom: 14px;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 5px;
  background: rgba(255, 253, 248, 0.96);
  color: var(--ink);
  border-radius: 999px;
  box-shadow: var(--shadow);
}
.one-dock > button {
  border: 0;
  background: transparent;
  border-radius: 999px;
  padding: 8px 14px;
  font-weight: 800;
}
.one-dock > button.is-on { background: var(--forest); color: #f6f1e8; }
.one-dock .langs { border-color: rgba(28, 22, 18, 0.25); margin-left: 4px; }

.overlay { position: fixed; inset: 0; background: rgba(20, 20, 16, 0.45); z-index: 30; }
.cart {
  position: fixed;
  top: 0;
  right: 0;
  z-index: 31;
  width: min(420px, 100%);
  height: 100%;
  background: var(--paper);
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  padding: 18px;
}
.cart header, .cart footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.cart header h2 { font-family: var(--serif); font-size: 34px; font-weight: 560; }
.icon-btn { border: 0; background: var(--cream); width: 40px; height: 40px; border-radius: 50%; }
.cart-body { flex: 1; overflow: auto; padding: 8px 0; }
.cart label { display: block; font-weight: 750; margin: 12px 0 6px; }
textarea {
  width: 100%;
  border: 1px solid var(--line);
  background: #fff;
  border-radius: 14px;
  padding: 12px;
  min-height: 90px;
  resize: vertical;
}
.cart footer { flex-direction: column; align-items: stretch; gap: 10px; }
.cart-line, .bill-total { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-top: 1px solid var(--line); }
.bill-total { font-size: 20px; }
.send { width: 100%; }
.toast {
  position: fixed;
  left: 50%;
  bottom: 78px;
  transform: translateX(-50%) translateY(20px);
  background: var(--ink);
  color: white;
  border-radius: 999px;
  padding: 12px 16px;
  z-index: 50;
  opacity: 0;
  pointer-events: none;
  transition: 0.2s ease;
}
.toast.is-on { opacity: 1; transform: translateX(-50%) translateY(0); }

@media (max-width: 980px) {
  .hero-grid, .qr-grid, .statbar, .record-kpis { grid-template-columns: 1fr 1fr; }
  .hero-grid, .qr-grid { grid-template-columns: 1fr; }
  .dish-grid { grid-template-columns: 1fr 1fr; }
  .ticket { left: 12px; }
}
@media (max-width: 720px) {
  .nav-links { display: none; }
  .statbar, .record-kpis, .dish-grid { grid-template-columns: 1fr; }
  .hero { padding-top: 76px; }
  .hero-photo img { height: 320px; border-radius: 24px; }
  .footer { flex-direction: column; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .dish, .welcome-track { animation: none; }
  .welcome { height: auto; }
  .welcome-track { width: auto; }
  .welcome-track p { white-space: normal; padding: 4px 20px; line-height: 1.4; }
  .welcome-track p[aria-hidden="true"] { display: none; }
}